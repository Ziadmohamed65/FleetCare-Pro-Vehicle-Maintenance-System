@model FleetCare_Pro.Models.ViewModels.Vehicle.VehicleDetailsViewModel

@{
    ViewData["Title"] = "Vehicle Details";
}

<style>
    .details-page {
        padding: 20px 0 50px;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .eyebrow {
        color: #0d6efd;
        font-size: .76rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .details-header h1 {
        color: #172033;
        font-size: 1.9rem;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .details-header p {
        color: #8992a3;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 8px;
    }

        .header-actions .btn {
            border-radius: 9px;
            padding: 9px 15px;
            font-size: .8rem;
            font-weight: 650;
        }

    .details-card {
        background: #fff;
        border: 1px solid #e5eaf1;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(23, 32, 51, .06);
        overflow: hidden;
    }

    .vehicle-image-area {
        height: 100%;
        min-height: 390px;
        background: #f4f7fb;
        overflow: hidden;
    }

    .vehicle-image {
        width: 100%;
        height: 100%;
        min-height: 390px;
        object-fit: cover;
    }

    .no-image {
        min-height: 390px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #9aa4b2;
        background: linear-gradient(135deg, #f5f7fa, #edf2f7);
    }

        .no-image i {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .no-image span {
            font-size: .8rem;
            font-weight: 600;
        }

    .details-content {
        padding: 28px;
    }

    .vehicle-title {
        color: #172033;
        font-size: 1.4rem;
        font-weight: 750;
        margin-bottom: 23px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .info-item {
        padding: 14px;
        background: #f8faff;
        border: 1px solid #edf1f6;
        border-radius: 11px;
    }

    .info-label {
        display: block;
        color: #8992a3;
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 5px;
    }

    .info-value {
        color: #253047;
        font-size: .84rem;
        font-weight: 700;
        word-break: break-word;
    }

    .status-value {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #198754;
    }

    .details-actions {
        display: flex;
        gap: 9px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf0f5;
    }

        .details-actions .btn {
            border-radius: 9px;
            padding: 9px 16px;
            font-size: .81rem;
            font-weight: 650;
        }

    @@media (max-width: 767px) {
        .details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-actions {
            width: 100%;
        }

            .header-actions .btn {
                flex: 1;
            }

        .vehicle-image-area,
        .vehicle-image,
        .no-image {
            min-height: 270px;
        }

        .details-content {
            padding: 20px;
        }
    }

    @@media (max-width: 500px) {
        .info-grid {
            grid-template-columns: 1fr;
        }

        .details-actions {
            flex-direction: column;
        }

            .details-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="container details-page">

    <div class="details-header">

        <div>

            <div class="eyebrow">
                Fleet Management
            </div>

            <h1>
                Vehicle Details
            </h1>

            <p>
                Complete information and current status of this vehicle.
            </p>

        </div>

        <div class="header-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-light border">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

        </div>

    </div>

    <div class="details-card">

        <div class="row g-0">

            <div class="col-lg-5">

                @if (!string.IsNullOrEmpty(Model.VehicleImageURL))
                {
                    <div class="vehicle-image-area">

                        <img src="@Model.VehicleImageURL"
                             class="vehicle-image"
                             alt="@Model.Make @Model.Model" />

                    </div>
                }
                else
                {
                    <div class="no-image">

                        <i class="bi bi-car-front"></i>

                        <span>
                            No Vehicle Image
                        </span>

                    </div>
                }

            </div>

            <div class="col-lg-7">

                <div class="details-content">

                    <h2 class="vehicle-title">
                        @Model.Make @Model.Model
                    </h2>

                    <div class="info-grid">

                        <div class="info-item">

                            <span class="info-label">
                                VIN
                            </span>

                            <span class="info-value">
                                @Model.VIN
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                License Plate
                            </span>

                            <span class="info-value">
                                @Model.LicensePlate
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Make
                            </span>

                            <span class="info-value">
                                @Model.Make
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Model
                            </span>

                            <span class="info-value">
                                @Model.Model
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Year
                            </span>

                            <span class="info-value">
                                @Model.Year
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Purchase Price
                            </span>

                            <span class="info-value">
                                @Model.PurchasePrice.ToString("C")
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Mileage
                            </span>

                            <span class="info-value">
                                @Model.Mileage.ToString("N0") km
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Status
                            </span>

                            <span class="info-value status-value">

                                <span class="status-dot"></span>

                                @Model.Status

                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Driver
                            </span>

                            <span class="info-value">
                                @(Model.DriverName ?? "Unassigned")
                            </span>

                        </div>

                        <div class="info-item">

                            <span class="info-label">
                                Service Records
                            </span>

                            <span class="info-value">
                                @Model.ServiceRecordCount
                            </span>

                        </div>

                    </div>

                    <div class="details-actions">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">

                            <i class="bi bi-pencil me-2"></i>
                            Edit Vehicle

                        </a>

                        <a asp-action="Index"
                           class="btn btn-light border">

                            <i class="bi bi-arrow-left me-2"></i>
                            Back to Vehicles

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
```