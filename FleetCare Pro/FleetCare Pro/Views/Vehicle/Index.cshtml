@model IEnumerable<FleetCare_Pro.Models.Domain.Vehicle>

@{
    ViewData["Title"] = "Vehicles";
}

<style>
    .vehicles-page {
        padding: 15px 0 50px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #0d6efd;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .page-header h1 {
        color: #172033;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .page-header p {
        color: #8992a3;
        margin: 0;
    }

    .add-btn {
        border-radius: 11px;
        padding: 11px 18px;
        font-weight: 650;
        white-space: nowrap;
        box-shadow: 0 5px 14px rgba(13, 110, 253, .16);
    }

    .alert {
        border: none;
        border-radius: 12px;
    }

    .vehicles-card {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(23, 32, 51, .06);
        overflow: hidden;
    }

    .table-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .table-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #e9f2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .table-header h5 {
        margin: 0;
        color: #172033;
        font-weight: 700;
    }

    .table-header span {
        color: #8992a3;
        font-size: .82rem;
    }

    .vehicles-table {
        margin: 0;
    }

        .vehicles-table thead th {
            background: #f7f9fc;
            color: #697386;
            border-bottom: 1px solid #e5e9f0;
            font-size: .73rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 15px 16px;
            white-space: nowrap;
        }

        .vehicles-table tbody td {
            padding: 14px 16px;
            border-color: #edf0f5;
            color: #4b5563;
            vertical-align: middle;
        }

        .vehicles-table tbody tr {
            transition: background .15s ease;
        }

            .vehicles-table tbody tr:hover {
                background: #fafcff;
            }

    .vehicle-thumb {
        width: 68px;
        height: 48px;
        object-fit: cover;
        border-radius: 9px;
        border: 1px solid #e1e7ef;
    }

    .image-placeholder {
        width: 68px;
        height: 48px;
        border-radius: 9px;
        background: #f3f6fa;
        color: #a1aab8;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .vin-value {
        color: #253047;
        font-size: .78rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .plate-value {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        border-radius: 7px;
        background: #f2f5f9;
        color: #344054;
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .vehicle-name {
        color: #172033;
        font-weight: 700;
        white-space: nowrap;
    }

    .year-value,
    .mileage-value {
        color: #4b5563;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 8px;
        background: #eaf8f0;
        color: #198754;
        font-size: .74rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .driver-value {
        color: #4b5563;
        font-size: .8rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .unassigned {
        color: #9aa3b1;
        font-weight: 500;
    }

    .action-buttons {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            border-radius: 8px;
            padding: 6px 9px;
            font-size: .75rem;
            font-weight: 650;
            white-space: nowrap;
        }

    .btn-info {
        color: #0b5ed7;
        background: #eaf3ff;
        border-color: #eaf3ff;
    }

        .btn-info:hover {
            color: #084298;
            background: #dcecff;
            border-color: #dcecff;
        }

    .empty-vehicles {
        text-align: center;
        padding: 60px 20px;
        color: #8992a3;
    }

        .empty-vehicles i {
            display: block;
            font-size: 2.7rem;
            color: #b8c1cf;
            margin-bottom: 12px;
        }

        .empty-vehicles h5 {
            color: #4b5563;
            font-weight: 700;
        }

        .empty-vehicles p {
            margin-bottom: 18px;
            font-size: .82rem;
        }

    @@media (max-width: 1000px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-btn {
            width: 100%;
        }

        .vehicles-table {
            min-width: 1100px;
        }
    }
</style>

<div class="container vehicles-page">

    <div class="page-header">

        <div>

            <div class="eyebrow">
                Fleet Management
            </div>

            <h1>
                Vehicles
            </h1>

            <p>
                Manage your fleet, assignments, mileage, and vehicle status.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary add-btn">

            <i class="bi bi-plus-lg me-2"></i>
            Add Vehicle

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

        </div>
    }

    <div class="vehicles-card">

        <div class="table-header">

            <div class="table-header-icon">
                <i class="bi bi-car-front-fill"></i>
            </div>

            <div>

                <h5>
                    Fleet Vehicles
                </h5>

                <span>
                    All vehicles currently registered in the fleet
                </span>

            </div>

        </div>

        <div class="table-responsive">

            @if (!Model.Any())
            {
                <div class="empty-vehicles">

                    <i class="bi bi-car-front"></i>

                    <h5>
                        No Vehicles Found
                    </h5>

                    <p>
                        There are currently no vehicles registered in your fleet.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add First Vehicle

                    </a>

                </div>
            }
            else
            {
                <table class="table table-hover align-middle vehicles-table">

                    <thead>

                        <tr>

                            <th>Image</th>
                            <th>VIN</th>
                            <th>License Plate</th>
                            <th>Vehicle</th>
                            <th>Year</th>
                            <th>Mileage</th>
                            <th>Status</th>
                            <th>Driver</th>
                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var vehicle in Model)
                        {
                            <tr>

                                <td>

                                    @if (!string.IsNullOrEmpty(vehicle.VehicleImageURL))
                                    {
                                        <img src="@vehicle.VehicleImageURL"
                                             alt="@vehicle.Make @vehicle.Model"
                                             class="vehicle-thumb" />
                                    }
                                    else
                                    {
                                        <span class="image-placeholder">
                                            <i class="bi bi-car-front"></i>
                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="vin-value">
                                        @vehicle.VIN
                                    </span>

                                </td>

                                <td>

                                    <span class="plate-value">
                                        <i class="bi bi-card-text me-1"></i>
                                        @vehicle.LicensePlate
                                    </span>

                                </td>

                                <td>

                                    <div class="vehicle-name">
                                        @vehicle.Make @vehicle.Model
                                    </div>

                                </td>

                                <td>

                                    <span class="year-value">
                                        @vehicle.Year
                                    </span>

                                </td>

                                <td>

                                    <span class="mileage-value">
                                        @vehicle.Mileage.ToString("N0") km
                                    </span>

                                </td>

                                <td>

                                    <span class="status-badge">

                                        <span class="status-dot"></span>

                                        @vehicle.Status

                                    </span>

                                </td>

                                <td>

                                    @if (vehicle.Driver != null)
                                    {
                                        <span class="driver-value">
                                            <i class="bi bi-person me-1"></i>
                                            @vehicle.Driver.FullName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="driver-value unassigned">
                                            Unassigned
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@vehicle.Id"
                                           class="btn btn-info">

                                            <i class="bi bi-eye me-1"></i>
                                            Details

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@vehicle.Id"
                                           class="btn btn-warning">

                                            <i class="bi bi-pencil me-1"></i>
                                            Edit

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@vehicle.Id"
                                           class="btn btn-danger">

                                            <i class="bi bi-trash3 me-1"></i>
                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>