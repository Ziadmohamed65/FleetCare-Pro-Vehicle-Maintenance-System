@model FleetCare_Pro.Models.Domain.ServiceCenter

@{
    ViewData["Title"] = "Service Center Details";
}

<style>
    .details-page {
        padding: 15px 0 50px;
    }

    .details-card {
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 22px;
        box-shadow: 0 10px 35px rgba(23, 32, 51, .07);
        overflow: hidden;
    }

    .details-header {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        padding: 30px;
        color: white;
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255, 255, 255, .16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .details-header h1 {
        font-size: 1.65rem;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .details-header p {
        margin: 0;
        color: rgba(255, 255, 255, .8);
        font-size: .9rem;
    }

    .details-body {
        padding: 30px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        color: #172033;
        font-size: 1rem;
        font-weight: 750;
    }

        .section-title i {
            color: #0d6efd;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .info-item {
        padding: 17px;
        background: #f8fafc;
        border: 1px solid #edf0f5;
        border-radius: 13px;
    }

    .info-label {
        display: block;
        color: #8992a3;
        font-size: .74rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 6px;
    }

    .info-value {
        color: #172033;
        font-weight: 650;
        word-break: break-word;
    }

    .status-active,
    .status-inactive {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 700;
    }

    .status-active {
        background: #e9f8ef;
        color: #198754;
    }

    .status-inactive {
        background: #f1f3f6;
        color: #6c757d;
    }

    .records-card {
        margin-top: 28px;
        padding: 20px;
        border: 1px solid #e6eaf0;
        border-radius: 15px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .records-info {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .records-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #e9f2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .records-info h6 {
        margin: 0 0 3px;
        color: #172033;
        font-weight: 700;
    }

    .records-info span {
        color: #8992a3;
        font-size: .8rem;
    }

    .records-count {
        min-width: 44px;
        height: 38px;
        padding: 0 12px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #172033;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
    }

    .categories-section {
        margin-top: 28px;
        padding: 22px;
        border: 1px solid #e6eaf0;
        border-radius: 15px;
        background: #f8fafc;
    }

    .categories-placeholder {
        color: #8992a3;
        font-size: .88rem;
        margin: 0;
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid #edf0f5;
    }

        .actions .btn {
            border-radius: 10px;
            padding: 9px 17px;
            font-weight: 650;
        }

    @@media (max-width: 700px) {
        .details-header,
        .details-body {
            padding: 22px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .records-card {
            align-items: flex-start;
        }

        .actions {
            flex-direction: column;
        }

            .actions .btn {
                width: 100%;
            }
    }
</style>

<div class="container details-page">

    <div class="details-card">

        <div class="details-header">

            <div class="header-content">

                <div class="header-icon">
                    <i class="bi bi-buildings"></i>
                </div>

                <div>
                    <h1>
                        @Model.Name
                    </h1>

                    <p>
                        Service center details and maintenance information
                    </p>
                </div>

            </div>

        </div>

        <div class="details-body">

            <div class="section-title">
                <i class="bi bi-info-circle-fill"></i>
                Center Information
            </div>

            <div class="info-grid">

                <div class="info-item">
                    <span class="info-label">
                        Name
                    </span>

                    <div class="info-value">
                        @Model.Name
                    </div>
                </div>

                <div class="info-item">
                    <span class="info-label">
                        Phone
                    </span>

                    <div class="info-value">
                        @Model.PhoneNumber
                    </div>
                </div>

                <div class="info-item">
                    <span class="info-label">
                        Email
                    </span>

                    <div class="info-value">
                        @(Model.Email ?? "-")
                    </div>
                </div>

                <div class="info-item">
                    <span class="info-label">
                        Address
                    </span>

                    <div class="info-value">
                        @Model.Address
                    </div>
                </div>

                <div class="info-item">

                    <span class="info-label">
                        Status
                    </span>

                    <div class="info-value">

                        @if (Model.IsActive)
                        {
                            <span class="status-active">
                                <i class="bi bi-check-circle-fill"></i>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="status-inactive">
                                <i class="bi bi-pause-circle-fill"></i>
                                Inactive
                            </span>
                        }

                    </div>

                </div>

            </div>

            <div class="records-card">

                <div class="records-info">

                    <div class="records-icon">
                        <i class="bi bi-clipboard2-check"></i>
                    </div>

                    <div>
                        <h6>Service Records</h6>
                        <span>Total maintenance records associated with this center</span>
                    </div>

                </div>

                <div class="records-count">
                    @Model.ServiceRecords.Count
                </div>

            </div>

            <div class="categories-section">

                <div class="section-title mb-2">
                    <i class="bi bi-tags-fill"></i>
                    Available Service Categories
                </div>

                <p class="categories-placeholder">
                    Service categories available at this center will appear here.
                </p>

            </div>

            <div class="actions">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back
                </a>

            </div>

        </div>

    </div>

</div>
 
