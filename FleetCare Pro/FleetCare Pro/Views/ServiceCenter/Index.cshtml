@model IEnumerable<FleetCare_Pro.Models.Domain.ServiceCenter>

@{
    ViewData["Title"] = "Service Centers";
}

<style>
    .centers-page {
        padding: 15px 0 50px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #0d6efd;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .page-header h1 {
        color: #172033;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .page-header p {
        color: #6b7280;
        margin: 0;
    }

    .add-btn {
        border-radius: 11px;
        padding: 11px 18px;
        font-weight: 650;
        white-space: nowrap;
        box-shadow: 0 5px 14px rgba(13, 110, 253, .16);
    }

    .alert {
        border-radius: 12px;
        border: none;
    }

    .table-card {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(23, 32, 51, .06);
        overflow: hidden;
    }

    .table-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .table-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e9f2ff;
        color: #0d6efd;
    }

    .table-header h5 {
        margin: 0;
        color: #172033;
        font-weight: 700;
    }

    .table-header span {
        color: #8992a3;
        font-size: .82rem;
    }

    .table {
        margin: 0;
    }

        .table thead th {
            background: #f7f9fc;
            color: #697386;
            border-bottom: 1px solid #e5e9f0;
            font-size: .76rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 15px 18px;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 17px 18px;
            border-color: #edf0f5;
            color: #4b5563;
            vertical-align: middle;
        }


    .center-name {
        color: #172033;
        font-weight: 700;
    }

    .contact-value {
        white-space: nowrap;
    }

    .address-value {
        max-width: 220px;
        color: #737d8e;
    }

    .status-active {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 8px;
        background: #e9f8ef;
        color: #198754;
        font-size: .78rem;
        font-weight: 700;
    }

    .status-inactive {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 8px;
        background: #f1f3f6;
        color: #6c757d;
        font-size: .78rem;
        font-weight: 700;
    }

    .count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 30px;
        padding: 0 9px;
        border-radius: 8px;
        background: #f1f3f6;
        color: #4b5563;
        font-weight: 650;
        font-size: .82rem;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            border-radius: 8px;
            font-weight: 600;
            padding: 6px 10px;
        }

    .btn-info {
        color: #0b5ed7;
        background: #eaf3ff;
        border-color: #eaf3ff;
    }

        .btn-info:hover {
            color: #084298;
            background: #dcecff;
            border-color: #dcecff;
        }

    @@media (max-width: 900px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-btn {
            width: 100%;
        }
    }
</style>

<div class="container centers-page">

    <div class="page-header">

        <div>

            <div class="eyebrow">
                Service Management
            </div>

            <h1>
                Service Centers
            </h1>

            <p>
                Manage maintenance providers and their service activity.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary add-btn">
            <i class="bi bi-plus-lg me-2"></i>
            Add Service Center
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="table-card">

        <div class="table-header">

            <div class="table-header-icon">
                <i class="bi bi-buildings"></i>
            </div>

            <div>
                <h5>Service Center Network</h5>
                <span>Maintenance providers registered in FleetCare Pro</span>
            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th>Services</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var serviceCenter in Model)
                    {
                        <tr>

                            <td>
                                <div class="center-name">
                                    @serviceCenter.Name
                                </div>
                            </td>

                            <td>
                                <span class="contact-value">
                                    @serviceCenter.PhoneNumber
                                </span>
                            </td>

                            <td>
                                <span class="contact-value">
                                    @(serviceCenter.Email ?? "-")
                                </span>
                            </td>

                            <td>
                                <div class="address-value">
                                    @serviceCenter.Address
                                </div>
                            </td>

                            <td>

                                @if (serviceCenter.IsActive)
                                {
                                    <span class="status-active">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        <i class="bi bi-pause-circle-fill"></i>
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>
                                <span class="count-badge">
                                    @serviceCenter.ServiceRecords.Count
                                </span>
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@serviceCenter.Id"
                                       class="btn btn-sm btn-info">
                                        <i class="bi bi-eye me-1"></i>
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@serviceCenter.Id"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil me-1"></i>
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@serviceCenter.Id"
                                       class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash3 me-1"></i>
                                        Delete
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </div>

</div>
