@model FleetCare_Pro.Models.ViewModels.ServiceCenter.ServiceCenterCreateViewModel

@{
    ViewData["Title"] = "Add Service Center";
}

<style>
    .service-center-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 0 50px;
    }

    .page-header {
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #0d6efd;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .page-header h1 {
        color: #172033;
        font-weight: 750;
        margin: 0 0 6px;
    }

    .page-header p {
        color: #6b7280;
        margin: 0;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(23, 32, 51, .06);
        overflow: hidden;
    }

    .card-header-custom {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 24px 28px;
        border-bottom: 1px solid #edf0f5;
        background: linear-gradient(135deg, #f8fbff, #fff);
    }

    .header-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e9f2ff;
        color: #0d6efd;
        font-size: 1.3rem;
    }

    .card-header-custom h5 {
        margin: 0;
        color: #172033;
        font-weight: 700;
    }

    .card-header-custom span {
        color: #7b8494;
        font-size: .87rem;
    }

    .form-body {
        padding: 30px;
    }

    .form-label {
        color: #273247;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .form-control {
        border: 1px solid #dfe4ec;
        border-radius: 11px;
        padding: 11px 14px;
        transition: all .2s ease;
    }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .1);
        }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .active-box {
        padding: 15px 17px;
        border: 1px solid #e5e9f0;
        border-radius: 12px;
        background: #fafbfd;
    }

    .form-check-input {
        width: 19px;
        height: 19px;
        margin-top: .1em;
    }

    .form-check-label {
        margin-left: 5px;
        color: #273247;
        font-weight: 600;
    }

    .action-row {
        display: flex;
        gap: 10px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid #edf0f5;
    }

    .btn {
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .btn-primary {
        box-shadow: 0 5px 14px rgba(13, 110, 253, .18);
    }

    .btn-secondary {
        background: #f1f3f6;
        color: #4b5563;
        border: none;
    }

        .btn-secondary:hover {
            background: #e4e7ec;
            color: #273247;
        }

    @@media (max-width: 576px) {
        .form-body

    {
        padding: 22px;
    }

    .card-header-custom {
        padding: 20px 22px;
    }

    .action-row {
        flex-direction: column;
    }

        .action-row .btn {
            width: 100%;
        }

    }
</style>

<div class="container service-center-page">

    <div class="page-header">
        <div class="eyebrow">Service Management</div>
        <h1>Add Service Center</h1>
        <p>Register a maintenance center for your FleetCare Pro network.</p>
    </div>

    <div class="form-card">

        <div class="card-header-custom">

            <div class="header-icon">
                <i class="bi bi-building-add"></i>
            </div>

            <div>
                <h5>Service Center Information</h5>
                <span>Enter the contact and location details below.</span>
            </div>

        </div>

        <div class="form-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger border-0 rounded-3 mb-4">
                </div>

                <div class="mb-4">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter service center name" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <div class="mb-4">

                    <label asp-for="Address"
                           class="form-label">
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Enter address">
                    </textarea>

                    <span asp-validation-for="Address"
                          class="text-danger small">
                    </span>

                </div>

                <div class="active-box">

                    <div class="form-check">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Active
                        </label>

                    </div>

                </div>

                <div class="action-row">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>
                        Create Service Center
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
 
