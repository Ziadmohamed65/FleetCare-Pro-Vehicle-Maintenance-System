

@model FleetCare_Pro.Models.Domain.ServiceCenter

@{
    ViewData["Title"] = "Delete Service Center";
}

<style>
    .delete-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 35px 0 60px;
    }

    .delete-card {
        background: #fff;
        border: 1px solid #f0d2d2;
        border-radius: 22px;
        box-shadow: 0 12px 40px rgba(23, 32, 51, .07);
        overflow: hidden;
    }

    .delete-header {
        padding: 30px;
        text-align: center;
        background: linear-gradient(135deg, #fff8f8, #fff);
        border-bottom: 1px solid #f4e1e1;
    }

    .delete-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 16px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fdecec;
        color: #dc3545;
        font-size: 1.8rem;
    }

    .delete-header h1 {
        color: #172033;
        font-size: 1.7rem;
        font-weight: 750;
        margin-bottom: 8px;
    }

    .delete-header p {
        color: #6b7280;
        margin: 0;
    }

    .delete-body {
        padding: 30px;
    }

    .summary-card {
        border: 1px solid #e7ebf2;
        border-radius: 15px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 18px;
        border-bottom: 1px solid #edf0f5;
    }

        .summary-row:last-child {
            border-bottom: none;
        }

    .summary-label {
        color: #737d8e;
        font-weight: 600;
    }

    .summary-value {
        color: #172033;
        font-weight: 650;
        text-align: right;
    }

    .warning-box {
        display: flex;
        gap: 12px;
        padding: 16px;
        border-radius: 13px;
        background: #fff8e6;
        border: 1px solid #ffe4a3;
        color: #765a13;
        margin-bottom: 28px;
    }

        .warning-box i {
            font-size: 1.2rem;
            margin-top: 2px;
        }

    .action-row {
        display: flex;
        gap: 10px;
    }

    .btn {
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .btn-danger {
        box-shadow: 0 5px 14px rgba(220, 53, 69, .18);
    }

    .btn-secondary {
        background: #f1f3f6;
        color: #4b5563;
        border: none;
    }

   
    .summary-row {
        flex-direction: column;
        gap: 5px;
    }

    .summary-value {
        text-align: left;
    }

    .action-row {
        flex-direction: column;
    }

        .action-row .btn {
            width: 100%;
        }

    }
</style>

<div class="container delete-page">

    <div class="delete-card">

        <div class="delete-header">

            <div class="delete-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <h1>Delete Service Center</h1>

            <p>
                Are you sure you want to delete this service center?
            </p>

        </div>

        <div class="delete-body">

            <div class="summary-card">

                <div class="summary-row">

                    <div class="summary-label">
                        <i class="bi bi-building me-2"></i>
                        Name
                    </div>

                    <div class="summary-value">
                        @Model.Name
                    </div>

                </div>

                <div class="summary-row">

                    <div class="summary-label">
                        <i class="bi bi-telephone me-2"></i>
                        Phone
                    </div>

                    <div class="summary-value">
                        @Model.PhoneNumber
                    </div>

                </div>

                <div class="summary-row">

                    <div class="summary-label">
                        <i class="bi bi-geo-alt me-2"></i>
                        Address
                    </div>

                    <div class="summary-value">
                        @Model.Address
                    </div>

                </div>

            </div>

            <div class="warning-box">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>
                    <strong>Important</strong>
                    <div class="small mt-1">
                        Deleting this service center may affect related service records.
                        Make sure you want to continue.
                    </div>
                </div>

            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div class="action-row">

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash3 me-2"></i>
                        Delete Service Center
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
