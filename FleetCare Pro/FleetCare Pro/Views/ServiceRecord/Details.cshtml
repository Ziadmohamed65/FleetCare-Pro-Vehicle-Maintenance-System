
@model FleetCare_Pro.Models.Domain.ServiceRecord

@{
    ViewData["Title"] = "Service Record Details";
}

<style>
    .details-page {
        padding: 15px 0 50px;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #0d6efd;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .details-header h1 {
        color: #172033;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .details-header p {
        color: #6b7280;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 8px;
    }

        .header-actions .btn {
            border-radius: 10px;
            padding: 10px 16px;
            font-weight: 650;
        }

    .info-card,
    .service-items-card {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(23,32,51,.05);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 22px;
        border-bottom: 1px solid #edf0f5;
    }

    .heading-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 11px;
        background: #eaf3ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-heading h5 {
        margin: 0;
        color: #172033;
        font-weight: 700;
    }

    .card-body-custom {
        padding: 22px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid #f0f2f6;
    }

        .detail-row:first-child {
            padding-top: 0;
        }

        .detail-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .detail-label {
        color: #8992a3;
        font-size: .84rem;
        font-weight: 600;
    }

    .detail-value {
        color: #172033;
        font-weight: 650;
        text-align: right;
    }

    .vehicle-highlight {
        background: #f7f9fc;
        border: 1px solid #edf0f5;
        border-radius: 13px;
        padding: 15px;
        margin-bottom: 16px;
    }

    .vehicle-highlight-title {
        color: #172033;
        font-size: 1.05rem;
        font-weight: 750;
    }

    .vehicle-highlight-subtitle {
        color: #8992a3;
        font-size: .78rem;
        margin-top: 3px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 8px;
        background: #eef2f6;
        color: #5b6575;
        font-size: .77rem;
        font-weight: 700;
    }

        .status-badge i {
            font-size: .42rem;
        }

    .notes-box {
        color: #4b5563;
        line-height: 1.7;
        white-space: pre-line;
    }

    .empty-note {
        color: #9aa3b2;
        font-style: italic;
    }

    .invoice-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px;
        border: 1px solid #e6eaf0;
        border-radius: 13px;
        background: #f9fbfd;
    }

    .invoice-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .invoice-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 11px;
        background: #ffecec;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .invoice-title {
        color: #172033;
        font-weight: 700;
        font-size: .9rem;
    }

    .invoice-subtitle {
        color: #8992a3;
        font-size: .76rem;
    }

    .service-items-card {
        margin-bottom: 0;
    }

    .items-table {
        margin: 0;
    }

        .items-table thead th {
            background: #f7f9fc;
            color: #697386;
            border-bottom: 1px solid #e5e9f0;
            font-size: .74rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 14px 18px;
            white-space: nowrap;
        }

        .items-table tbody td {
            padding: 16px 18px;
            border-color: #edf0f5;
            color: #4b5563;
            vertical-align: middle;
        }

    .category-name {
        color: #172033;
        font-weight: 700;
    }

    .cost-value {
        color: #172033;
        font-weight: 700;
        white-space: nowrap;
    }

    .empty-items {
        padding: 30px;
        text-align: center;
        color: #8992a3;
    }

    .total-row th {
        background: #f7f9fc;
        color: #172033;
        padding: 17px 18px;
        border-top: 2px solid #e5e9f0;
    }

    .total-value {
        color: #0d6efd !important;
        font-size: 1.05rem;
        white-space: nowrap;
    }

    @@media (max-width: 768px) {
        .details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-actions {
            width: 100%;
        }

            .header-actions .btn {
                flex: 1;
            }

        .detail-row {
            flex-direction: column;
            gap: 4px;
        }

        .detail-value {
            text-align: left;
        }

        .invoice-box {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="container details-page">

    <div class="details-header">

        <div>
            <div class="eyebrow">
                Maintenance Management
            </div>

            <h1>
                Service Record Details
            </h1>

            <p>
                Review the maintenance activity and service costs for this record.
            </p>
        </div>

        <div class="header-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>

        </div>

    </div>

    <div class="row">

        <!-- Service Information -->
        <div class="col-lg-6">

            <div class="info-card">

                <div class="card-heading">

                    <div class="heading-icon">
                        <i class="bi bi-clipboard2-check"></i>
                    </div>

                    <h5>Service Information</h5>

                </div>

                <div class="card-body-custom">

                    @if (Model.Vehicle != null)
                    {
                        <div class="vehicle-highlight">

                            <div class="vehicle-highlight-title">
                                @Model.Vehicle.Make @Model.Vehicle.Model
                            </div>

                            <div class="vehicle-highlight-subtitle">
                                License Plate: @Model.Vehicle.LicensePlate
                            </div>

                        </div>

                        <div class="detail-row">

                            <span class="detail-label">
                                VIN
                            </span>

                            <span class="detail-value">
                                @Model.Vehicle.VIN
                            </span>

                        </div>
                    }

                    <div class="detail-row">

                        <span class="detail-label">
                            Service Center
                        </span>

                        <span class="detail-value">
                            @(Model.ServiceCenter?.Name ?? "Not specified")
                        </span>

                    </div>

                    <div class="detail-row">

                        <span class="detail-label">
                            Service Date
                        </span>

                        <span class="detail-value">
                            @Model.ServiceDate.ToString("yyyy-MM-dd")
                        </span>

                    </div>

                    <div class="detail-row">

                        <span class="detail-label">
                            Current Mileage
                        </span>

                        <span class="detail-value">
                            @Model.CurrentMileage.ToString("N0") km
                        </span>

                    </div>

                    <div class="detail-row">

                        <span class="detail-label">
                            Status
                        </span>

                        <span class="detail-value">

                            <span class="status-badge">
                                <i class="bi bi-circle-fill"></i>
                                @Model.Status
                            </span>

                        </span>

                    </div>

                    <div class="detail-row">

                        <span class="detail-label">
                            Created By
                        </span>

                        <span class="detail-value">
                            @(Model.CreatedByUser?.FullName ?? "Not specified")
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- Notes / Invoice -->
        <div class="col-lg-6">

            <div class="info-card">

                <div class="card-heading">

                    <div class="heading-icon">
                        <i class="bi bi-chat-left-text"></i>
                    </div>

                    <h5>Notes</h5>

                </div>

                <div class="card-body-custom">

                    @if (string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="empty-note">
                            No notes were added to this service record.
                        </div>
                    }
                    else
                    {
                        <div class="notes-box">
                            @Model.Notes
                        </div>
                    }

                </div>

            </div>

            @if (!string.IsNullOrEmpty(Model.InvoiceDocumentPath))
            {
                <div class="info-card">

                    <div class="card-heading">

                        <div class="heading-icon">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <h5>Invoice</h5>

                    </div>

                    <div class="card-body-custom">

                        <div class="invoice-box">

                            <div class="invoice-info">

                                <div class="invoice-icon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>

                                <div>
                                    <div class="invoice-title">
                                        Service Invoice
                                    </div>

                                    <div class="invoice-subtitle">
                                        Attached service documentation
                                    </div>
                                </div>

                            </div>

                            <a href="@Model.InvoiceDocumentPath"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary">
                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                View Invoice
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

    <!-- Service Items -->
    <div class="service-items-card">

        <div class="card-heading">

            <div class="heading-icon">
                <i class="bi bi-list-check"></i>
            </div>

            <h5>Service Items</h5>

        </div>

        @if (Model.ServiceLineItems != null && Model.ServiceLineItems.Any())
        {
            <div class="table-responsive">

                <table class="table items-table">

                    <thead>

                        <tr>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Cost</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.ServiceLineItems)
                        {
                            <tr>

                                <td>
                                    <span class="category-name">
                                        @(item.ServiceCategory?.CategoryName ?? "Not specified")
                                    </span>
                                </td>

                                <td>
                                    @item.Description
                                </td>

                                <td>
                                    <span class="cost-value">
                                        @item.Cost.ToString("C")
                                    </span>
                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr class="total-row">

                            <th colspan="2" class="text-end">
                                Total Cost
                            </th>

                            <th class="total-value">
                                @Model.TotalCost.ToString("C")
                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }
        else
        {
            <div class="empty-items">
                <i class="bi bi-clipboard-x fs-4 d-block mb-2"></i>
                No service items were added to this record.
            </div>
        }

    </div>

</div>
