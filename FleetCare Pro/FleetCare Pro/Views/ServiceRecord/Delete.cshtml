@model FleetCare_Pro.Models.Domain.ServiceRecord

@{
    ViewData["Title"] = "Delete Service Record";
}

<style>
    .delete-page {
        padding: 35px 0 60px;
    }

    .delete-wrapper {
        max-width: 850px;
        margin: 0 auto;
    }

    .delete-card {
        background: #fff;
        border: 1px solid #f0d7d7;
        border-radius: 22px;
        box-shadow: 0 12px 40px rgba(23,32,51,.07);
        overflow: hidden;
    }

    .delete-header {
        padding: 28px 32px;
        background: linear-gradient(135deg, #fff5f5, #fffafa);
        border-bottom: 1px solid #f3dede;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .delete-icon {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: #ffe3e3;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .delete-header h1 {
        color: #172033;
        font-size: 1.45rem;
        font-weight: 750;
        margin: 0 0 4px;
    }

    .delete-header p {
        color: #7b8494;
        margin: 0;
        font-size: .9rem;
    }

    .delete-body {
        padding: 30px 32px;
    }

    .warning-message {
        display: flex;
        gap: 12px;
        padding: 16px;
        background: #fff8e8;
        border: 1px solid #f8e3a8;
        border-radius: 13px;
        color: #735c16;
        margin-bottom: 25px;
    }

        .warning-message i {
            color: #d39e00;
            font-size: 1.1rem;
            margin-top: 1px;
        }

        .warning-message strong {
            display: block;
            margin-bottom: 3px;
        }

    .record-summary {
        background: #f8fafc;
        border: 1px solid #e7ebf1;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 22px;
    }

    .summary-title {
        color: #172033;
        font-weight: 750;
        font-size: 1rem;
        margin-bottom: 15px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 11px 0;
        border-bottom: 1px solid #e8ecf2;
    }

        .summary-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .summary-row:first-of-type {
            padding-top: 0;
        }

    .summary-label {
        color: #8992a3;
        font-size: .84rem;
        font-weight: 600;
    }

    .summary-value {
        color: #172033;
        font-weight: 650;
        text-align: right;
    }

    .danger-warning {
        padding: 15px 16px;
        background: #fff0f0;
        border: 1px solid #f5d0d0;
        border-radius: 12px;
        color: #842029;
        font-size: .88rem;
        margin-bottom: 25px;
    }

        .danger-warning i {
            margin-right: 7px;
        }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }

        .delete-actions .btn {
            border-radius: 10px;
            padding: 10px 17px;
            font-weight: 650;
        }

        .delete-actions .btn-danger {
            box-shadow: 0 5px 14px rgba(220,53,69,.15);
        }

    @@media (max-width: 600px) {
        .delete-body,
        .delete-header {
            padding: 22px;
        }

        .summary-row {
            flex-direction: column;
            gap: 3px;
        }

        .summary-value {
            text-align: left;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

            .delete-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="container delete-page">

    <div class="delete-wrapper">

        <div class="delete-card">

            <div class="delete-header">

                <div class="delete-icon">
                    <i class="bi bi-trash3"></i>
                </div>

                <div>
                    <h1>Delete Service Record</h1>

                    <p>
                        This action cannot be undone.
                    </p>
                </div>

            </div>

            <div class="delete-body">

                <div class="warning-message">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    <div>
                        <strong>
                            Are you sure you want to delete this record?
                        </strong>

                        Please review the service information below before continuing.
                    </div>

                </div>

                <div class="record-summary">

                    <div class="summary-title">
                        Service Record
                    </div>

                    <div class="summary-row">

                        <span class="summary-label">
                            Vehicle
                        </span>

                        <span class="summary-value">
                            @Model.Vehicle.Make
                            @Model.Vehicle.Model
                        </span>

                    </div>

                    <div class="summary-row">

                        <span class="summary-label">
                            Service Center
                        </span>

                        <span class="summary-value">
                            @Model.ServiceCenter.Name
                        </span>

                    </div>

                    <div class="summary-row">

                        <span class="summary-label">
                            Service Date
                        </span>

                        <span class="summary-value">
                            @Model.ServiceDate.ToString("yyyy-MM-dd")
                        </span>

                    </div>

                    <div class="summary-row">

                        <span class="summary-label">
                            Total Cost
                        </span>

                        <span class="summary-value">
                            @Model.TotalCost.ToString("C")
                        </span>

                    </div>

                </div>

                <div class="danger-warning">

                    <i class="bi bi-info-circle-fill"></i>

                    Deleting this record will also delete all of its service line items.

                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="delete-actions">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-danger">
                            <i class="bi bi-trash3 me-1"></i>
                            Yes, Delete
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>