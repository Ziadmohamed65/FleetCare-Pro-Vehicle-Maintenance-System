
@model IEnumerable<FleetCare_Pro.Models.Domain.ServiceRecord>

@{
    ViewData["Title"] = "Service Records";
}

<style>
    .records-page {
        padding: 15px 0 50px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #0d6efd;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .page-header h1 {
        color: #172033;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .page-header p {
        color: #6b7280;
        margin: 0;
    }

    .add-btn {
        border-radius: 11px;
        padding: 11px 18px;
        font-weight: 650;
        white-space: nowrap;
        box-shadow: 0 5px 14px rgba(13,110,253,.16);
    }

    .alert {
        border: none;
        border-radius: 12px;
    }

    .table-card {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(23,32,51,.06);
        overflow: hidden;
    }

    .table-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .table-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #e9f2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .table-header h5 {
        margin: 0;
        color: #172033;
        font-weight: 700;
    }

    .table-header span {
        color: #8992a3;
        font-size: .82rem;
    }

    .records-table {
        margin: 0;
    }

        .records-table thead th {
            background: #f7f9fc;
            color: #697386;
            border-bottom: 1px solid #e5e9f0;
            font-size: .74rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 15px 16px;
            white-space: nowrap;
        }

        .records-table tbody td {
            padding: 16px;
            border-color: #edf0f5;
            color: #4b5563;
            vertical-align: middle;
        }

        .records-table tbody tr {
            transition: background .15s ease;
        }

            .records-table tbody tr:hover {
                background: #fafcff;
            }

    .vehicle-name {
        color: #172033;
        font-weight: 700;
    }

    .license-plate {
        display: inline-block;
        margin-top: 3px;
        color: #8992a3;
        font-size: .76rem;
    }

    .date-value {
        white-space: nowrap;
    }

    .mileage-value {
        color: #4b5563;
        font-weight: 600;
        white-space: nowrap;
    }

    .money-value {
        color: #172033;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 8px;
        background: #eef2f6;
        color: #5b6575;
        font-size: .77rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .status-badge i {
            font-size: .42rem;
        }

    .created-by {
        white-space: nowrap;
        font-weight: 600;
        color: #4b5563;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            border-radius: 8px;
            padding: 6px 10px;
            font-size: .78rem;
            font-weight: 600;
            white-space: nowrap;
        }

    .btn-info {
        color: #0b5ed7;
        background: #eaf3ff;
        border-color: #eaf3ff;
    }

        .btn-info:hover {
            color: #084298;
            background: #dcecff;
            border-color: #dcecff;
        }

    .btn-warning {
        color: #664d03;
    }

    .empty-records {
        padding: 55px 20px;
        text-align: center;
        color: #8992a3;
    }

        .empty-records i {
            display: block;
            font-size: 2.5rem;
            margin-bottom: 12px;
            color: #b8c1cf;
        }

        .empty-records h5 {
            color: #4b5563;
            font-weight: 700;
        }

    @@media (max-width: 900px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-btn {
            width: 100%;
        }

        .records-table {
            min-width: 1000px;
        }
    }
</style>

<div class="container records-page">

    <div class="page-header">

        <div>
            <div class="eyebrow">
                Maintenance Management
            </div>

            <h1>
                Service Records
            </h1>

            <p>
                Track maintenance activity, costs, and service history.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary add-btn">

            <i class="bi bi-plus-lg me-2"></i>
            Add Service Record

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4">

            <i class="bi bi-exclamation-circle-fill me-2"></i>

            @TempData["Error"]

        </div>
    }

    <div class="table-card">

        <div class="table-header">

            <div class="table-header-icon">
                <i class="bi bi-clipboard2-check"></i>
            </div>

            <div>

                <h5>
                    Maintenance Records
                </h5>

                <span>
                    All recorded vehicle maintenance activity
                </span>

            </div>

        </div>

        <div class="table-responsive">

            @if (!Model.Any())
            {
                <div class="empty-records">

                    <i class="bi bi-clipboard-x"></i>

                    <h5>
                        No Service Records
                    </h5>

                    <p class="mb-0">
                        There are currently no maintenance records available.
                    </p>

                </div>
            }
            else
            {
                <table class="table table-hover align-middle records-table">

                    <thead>

                        <tr>
                            <th>Vehicle</th>
                            <th>Service Center</th>
                            <th>Date</th>
                            <th>Mileage</th>
                            <th>Total Cost</th>
                            <th>Status</th>
                            <th>Created By</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var record in Model)
                        {
                            <tr>

                                <td>

                                    <div class="vehicle-name">
                                        @record.Vehicle.Make
                                        @record.Vehicle.Model
                                    </div>

                                    <small class="license-plate">
                                        @record.Vehicle.LicensePlate
                                    </small>

                                </td>

                                <td>
                                    @record.ServiceCenter.Name
                                </td>

                                <td>

                                    <span class="date-value">
                                        @record.ServiceDate.ToString("yyyy-MM-dd")
                                    </span>

                                </td>

                                <td>

                                    <span class="mileage-value">
                                        @record.CurrentMileage.ToString("N0")
                                    </span>

                                </td>

                                <td>

                                    <span class="money-value">
                                        @record.TotalCost.ToString("C")
                                    </span>

                                </td>

                                <td>

                                    <span class="status-badge">

                                        <i class="bi bi-circle-fill"></i>

                                        @record.Status

                                    </span>

                                </td>

                                <td>

                                    <span class="created-by">
                                        @record.CreatedByUser.FullName
                                    </span>

                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@record.Id"
                                           class="btn btn-sm btn-info">

                                            <i class="bi bi-eye me-1"></i>
                                            Details

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@record.Id"
                                           class="btn btn-sm btn-warning">

                                            <i class="bi bi-pencil me-1"></i>
                                            Edit

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@record.Id"
                                           class="btn btn-sm btn-danger">

                                            <i class="bi bi-trash3 me-1"></i>
                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>

