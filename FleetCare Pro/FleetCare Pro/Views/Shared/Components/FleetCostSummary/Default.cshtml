@model decimal

<style>
    .maintenance-cost-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #ffffff 0%, #f7faff 100%);
        border: 1px solid #e3e9f2;
        border-radius: 18px;
        box-shadow: 0 8px 28px rgba(23, 32, 51, .06);
    }

        .maintenance-cost-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -45px;
            top: -45px;
            border-radius: 50%;
            background: rgba(13, 110, 253, .06);
        }

    .maintenance-cost-body {
        padding: 22px;
    }

    .cost-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #eaf3ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: 16px;
    }

    .cost-label {
        color: #8992a3;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 5px;
    }

    .cost-value {
        color: #172033;
        font-size: 1.8rem;
        font-weight: 750;
        line-height: 1.2;
        margin: 0;
    }

    .cost-subtitle {
        color: #8992a3;
        font-size: .78rem;
        margin-top: 7px;
    }
</style>

<div class="maintenance-cost-card mt-2">

    <div class="maintenance-cost-body">

        <div class="cost-icon">
            <i class="bi bi-cash-stack"></i>
        </div>

        <div class="cost-label">
            Total Maintenance Cost
        </div>

        <h2 class="cost-value">
            @Model.ToString("C")
        </h2>

        <div class="cost-subtitle">
            Total recorded service expenses
        </div>

    </div>

</div>
 
