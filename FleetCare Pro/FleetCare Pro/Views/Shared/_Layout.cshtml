<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

   
    <title>@ViewData["Title"] - FleetCare Pro</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FleetCare_Pro.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            background: #f6f8fc;
            color: #172033;
        }

        .fleet-navbar {
            background: linear-gradient(135deg, #111827 0%, #172033 100%);
            border-bottom: 1px solid rgba(255,255,255,.08);
            min-height: 68px;
        }

            .fleet-navbar .container-fluid {
                min-height: 68px;
            }

        .fleet-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #fff !important;
            font-size: 1.12rem;
            font-weight: 750;
            letter-spacing: -.02em;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0d6efd, #0b5ed7);
            color: #fff;
            font-size: 1rem;
            box-shadow: 0 5px 14px rgba(13,110,253,.25);
        }

        .fleet-navbar .navbar-nav {
            gap: 3px;
        }

        .fleet-navbar .nav-link {
            color: #b9c2d0 !important;
            font-size: .87rem;
            font-weight: 600;
            padding: 9px 11px !important;
            border-radius: 9px;
            transition: all .18s ease;
        }

            .fleet-navbar .nav-link:hover {
                color: #fff !important;
                background: rgba(255,255,255,.07);
            }

            .fleet-navbar .nav-link.active {
                color: #fff !important;
                background: rgba(13,110,253,.18);
            }

        .nav-icon {
            margin-right: 5px;
            font-size: .9rem;
        }

        .user-greeting {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #d8dee8 !important;
            white-space: nowrap;
        }

        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #263247;
            color: #9fc5ff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .82rem;
        }

        .logout-btn {
            border-radius: 9px;
            padding: 7px 13px;
            font-size: .8rem;
            font-weight: 650;
            transition: all .18s ease;
        }

            .logout-btn:hover {
                transform: translateY(-1px);
            }

        .register-btn {
            border-radius: 9px;
            padding: 7px 14px;
            font-size: .82rem;
            font-weight: 650;
            box-shadow: 0 4px 12px rgba(13,110,253,.2);
        }


        .fleet-main {
            min-height: calc(100vh - 135px);
            padding-top: 8px;
        }



        .fleet-footer {
            background: #fff;
            border-top: 1px solid #e6eaf0 !important;
            color: #8992a3;
            margin-top: 30px;
        }

            .fleet-footer a {
                color: #697386;
                font-weight: 600;
                transition: color .15s ease;
            }

                .fleet-footer a:hover {
                    color: #0d6efd;
                }

        @@media (max-width: 991px) {

            .fleet-navbar .navbar-collapse {
                padding: 12px 0 8px;
            }

            .fleet-navbar .navbar-nav {
                gap: 2px;
            }

            .fleet-navbar .nav-link {
                padding: 10px 12px !important;
            }

            .fleet-navbar .navbar-nav:last-child {
                margin-top: 10px;
                padding-top: 10px;
                border-top: 1px solid rgba(255,255,255,.08);
            }

            .register-btn,
            .logout-btn {
                margin-top: 4px !important;
            }
        }

        @@media (max-width: 576px) {

            .fleet-footer .d-flex {
                flex-direction: column;
                gap: 8px;
                align-items: flex-start !important;
            }

            .fleet-main {
                padding-top: 0;
            }
        }
    </style>
   

</head>

<body>

   
    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fleet-navbar shadow-sm">

            <div class="container-fluid px-4">

                <!-- Logo -->
                <a class="navbar-brand fleet-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">
                        <i class="bi bi-truck"></i>
                    </span>

                    <span>FleetCare Pro</span>

                </a>

                <!-- Mobile toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- LEFT SIDE -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- HOME - Everyone -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door nav-icon"></i>
                                Home

                            </a>
                        </li>


                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            @if (User.IsInRole("Driver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Driver"
                                       asp-action="Index">

                                        <i class="bi bi-truck nav-icon"></i>
                                        My Vehicle

                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="ServiceRecord"
                                       asp-action="MyServices">

                                        <i class="bi bi-wrench-adjustable nav-icon"></i>
                                        My Maintenance

                                    </a>
                                </li>
                            }


   
                            @if (User.IsInRole("FleetManager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Vehicle"
                                       asp-action="Index">

                                        <i class="bi bi-truck nav-icon"></i>
                                        Vehicles

                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="ServiceCenter"
                                       asp-action="Index">

                                        <i class="bi bi-building nav-icon"></i>
                                        Service Centers

                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="ServiceCategory"
                                       asp-action="Index">

                                        <i class="bi bi-tags nav-icon"></i>
                                        Service Categories

                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="ServiceRecord"
                                       asp-action="Index">

                                        <i class="bi bi-clipboard2-check nav-icon"></i>
                                        Service Records

                                    </a>
                                </li>
                            }


                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">

                                        <i class="bi bi-speedometer2 nav-icon"></i>
                                        Admin Dashboard

                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="ServiceCenter"
                                       asp-action="Index">

                                        <i class="bi bi-people nav-icon"></i>
                                        Service Centers

                                    </a>
                                </li>
                            }

                        }

                    </ul>


                    <!-- RIGHT SIDE -->
                    <ul class="navbar-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- USER NAME -->
                            <li class="nav-item">

                                <span class="nav-link user-greeting">

                                    <span class="user-avatar">
                                        <i class="bi bi-person"></i>
                                    </span>

                                    Hello, @(User.Identity.Name ?? "User")

                                </span>

                            </li>

                            <!-- LOGOUT -->
                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm logout-btn mt-1">

                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- LOGIN -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right nav-icon"></i>
                                    Login

                                </a>
                            </li>

                            <!-- REGISTER -->
                            <li class="nav-item">

                                <a class="btn btn-primary btn-sm register-btn mt-1"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    <i class="bi bi-person-plus me-1"></i>
                                    Register

                                </a>

                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <!-- MAIN CONTENT -->
    <div class="container-fluid px-4">

        <main role="main" class="pb-4 fleet-main">

            @RenderBody()

        </main>

    </div>


    <!-- FOOTER -->
    <footer class="fleet-footer mt-4 py-3">

        <div class="container-fluid px-4">

            <div class="d-flex justify-content-between align-items-center">

                <span>
                    <i class="bi bi-shield-check me-1"></i>
                    &copy; 2026 - FleetCare Pro
                </span>

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="text-decoration-none">

                    Privacy

                </a>

            </div>

        </div>

    </footer>


    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
   

</body>
</html>
