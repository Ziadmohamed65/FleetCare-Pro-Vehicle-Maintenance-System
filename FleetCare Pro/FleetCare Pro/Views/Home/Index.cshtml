@{
    ViewData["Title"] = "Home Page";
}

<style>
    .home-page {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
        background: radial-gradient(circle at 10% 20%, rgba(13,110,253,.08), transparent 32%), radial-gradient(circle at 90% 80%, rgba(25,135,84,.06), transparent 32%), #f6f8fc;
    }

    .hero-card {
        width: 100%;
        max-width: 850px;
        text-align: center;
        background: white;
        border: 1px solid #e7ebf1;
        border-radius: 26px;
        padding: 65px 40px;
        box-shadow: 0 15px 50px rgba(25,42,70,.07);
    }

    .hero-icon {
        width: 78px;
        height: 78px;
        margin: 0 auto 25px;
        border-radius: 23px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        color: white;
        font-size: 34px;
        box-shadow: 0 12px 28px rgba(13,110,253,.22);
    }

    .hero-title {
        color: #172033;
        font-size: 42px;
        font-weight: 800;
        letter-spacing: -1px;
        margin-bottom: 12px;
    }

    .hero-text {
        color: #7b8495;
        font-size: 16px;
        margin: 0 auto;
        max-width: 580px;
        line-height: 1.8;
    }

    .hero-brand {
        color: #0d6efd;
        font-weight: 700;
    }

    @@media (max-width: 576px) {
        .hero-card {
            padding: 45px 25px;
        }

        .hero-title {
            font-size: 32px;
        }

        .hero-text {
            font-size: 14px;
        }
    }
</style>

<div class="home-page">

    
    <div class="hero-card">

        <div class="hero-icon">
            <i class="bi bi-truck-front-fill"></i>
        </div>

        <h1 class="hero-title">
            Welcome to FleetCare Pro
        </h1>

        <p class="hero-text">
            Your centralized platform for managing vehicles,
            maintenance, service records, and fleet operations.
        </p>

    </div>
    

</div>
