@{
    ViewData["Title"] = "Maintenance";
}

<style>
    .maintenance-page {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: radial-gradient(circle at 20% 20%, rgba(13,110,253,.07), transparent 30%), radial-gradient(circle at 80% 80%, rgba(255,193,7,.07), transparent 30%), #f6f8fc;
    }

    .maintenance-card {
        width: 100%;
        max-width: 650px;
        text-align: center;
        background: white;
        border: 1px solid #e7ebf1;
        border-radius: 24px;
        padding: 55px 40px;
        box-shadow: 0 15px 50px rgba(25,42,70,.07);
    }

    .maintenance-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 24px;
        border-radius: 23px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff4df;
        color: #e59a00;
        font-size: 34px;
    }

    .maintenance-title {
        color: #172033;
        font-size: 29px;
        font-weight: 750;
        margin-bottom: 12px;
    }

    .maintenance-message {
        color: #667085;
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 7px;
    }

    .maintenance-submessage {
        color: #9aa2b1;
        font-size: 14px;
        margin: 0;
    }

    @@media (max-width: 576px) {
        .maintenance-card {
            padding: 42px 25px;
        }

        .maintenance-title {
            font-size: 24px;
        }
    }
</style>

<div class="maintenance-page">

    
    <div class="maintenance-card">

        <div class="maintenance-icon">
            <i class="bi bi-tools"></i>
        </div>

        <h1 class="maintenance-title">
            System Maintenance
        </h1>

        <p class="maintenance-message">
            FleetCare Pro is currently undergoing maintenance.
        </p>

        <p class="maintenance-submessage">
            Please check back later. We appreciate your patience.
        </p>

    </div>
    

</div>
