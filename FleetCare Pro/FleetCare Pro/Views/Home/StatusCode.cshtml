@model int

@{
    ViewData["Title"] = "Error";
}

<style>
    .error-page {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: radial-gradient(circle at 20% 20%, rgba(13, 110, 253, .07), transparent 30%), radial-gradient(circle at 80% 80%, rgba(220, 53, 69, .05), transparent 30%), #f6f8fc;
    }

    .error-card {
        width: 100%;
        max-width: 650px;
        text-align: center;
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 24px;
        padding: 55px 40px;
        box-shadow: 0 15px 50px rgba(25, 42, 70, .07);
    }

    .error-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 22px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf2ff;
        color: #0d6efd;
        font-size: 30px;
    }

    .error-code {
        font-size: 72px;
        line-height: 1;
        font-weight: 800;
        color: #172033;
        letter-spacing: -2px;
        margin-bottom: 12px;
    }

    .error-title {
        font-size: 25px;
        font-weight: 700;
        color: #202939;
        margin-bottom: 10px;
    }

    .error-description {
        max-width: 450px;
        margin: 0 auto 28px;
        color: #7b8495;
        font-size: 15px;
        line-height: 1.7;
    }

    .home-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 21px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        background: #0d6efd;
        color: white;
        box-shadow: 0 8px 20px rgba(13, 110, 253, .20);
        transition: all .2s ease;
    }

        .home-btn:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(13, 110, 253, .28);
        }

    @@media (max-width: 576px) {
        .error-card {
            padding: 42px 25px;
        }

        .error-code {
            font-size: 58px;
        }

        .error-title {
            font-size: 22px;
        }
    }
</style>

<div class="error-page">

    
    <div class="error-card">

        @if (Model == 404)
        {

            <div class="error-code">
                404
            </div>

            <h1 class="error-title">
                Page Not Found
            </h1>

            <p class="error-description">
                The page you're looking for doesn't exist or may have been moved.
                Please check the address or return to the dashboard.
            </p>
        }
        else if (Model == 500)
        {

            <div class="error-code">
                500
            </div>

            <h1 class="error-title">
                Server Error
            </h1>

            <p class="error-description">
                Something went wrong on our server.
                Please try again later.
            </p>
        }
        else
        {
            <div class="error-code">
                @Model
            </div>

            <h1 class="error-title">
                Something Went Wrong
            </h1>

            <p class="error-description">
                An error occurred while processing your request.
                Please return home and try again.
            </p>
        }

        <a asp-controller="Home"
           asp-action="Index"
           class="home-btn">

            <i class="bi bi-house-fill"></i>
            Return Home

        </a>

    </div>
     

</div>
