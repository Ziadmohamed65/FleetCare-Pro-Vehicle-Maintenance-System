@addTagHelper *, FleetCare_Pro

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .dashboard-page {
        padding: 30px 0 50px;
        background: #f6f8fc;
        min-height: calc(100vh - 70px);
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .dashboard-title {
        font-size: 30px;
        font-weight: 750;
        color: #172033;
        margin-bottom: 6px;
    }

    .dashboard-subtitle {
        color: #7b8495;
        margin: 0;
        font-size: 14px;
    }

    .header-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1px solid #e8ebf0;
        padding: 9px 15px;
        border-radius: 10px;
        color: #667085;
        font-size: 13px;
        box-shadow: 0 4px 15px rgba(25, 42, 70, 0.04);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        background: #20c997;
        border-radius: 50%;
        display: inline-block;
    }

    .section-title {
        font-size: 17px;
        font-weight: 700;
        color: #202939;
        margin-bottom: 16px;
    }

    .kpi-card {
        position: relative;
        height: 100%;
        background: #ffffff;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        padding: 22px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(25, 42, 70, 0.045);
        transition: all 0.25s ease;
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(25, 42, 70, 0.09);
            border-color: #dce3ed;
        }

    .kpi-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .kpi-label {
        color: #7b8495;
        font-size: 13px;
        font-weight: 600;
        margin: 0;
    }

    .kpi-icon {
        width: 43px;
        height: 43px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .icon-blue {
        background: #eaf2ff;
        color: #0d6efd;
    }

    .icon-purple {
        background: #f1edff;
        color: #7657d9;
    }

    .icon-orange {
        background: #fff3df;
        color: #e58b00;
    }

    .icon-green {
        background: #e8f8f1;
        color: #15966b;
    }

    .icon-yellow {
        background: #fff8df;
        color: #d99b00;
    }

    .kpi-value {
        color: #172033;
        font-size: 31px;
        font-weight: 750;
        line-height: 1;
        margin-bottom: 17px;
    }

    .kpi-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #0d6efd;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: gap 0.2s ease;
    }

        .kpi-link:hover {
            gap: 9px;
            color: #0b5ed7;
        }

    .kpi-status {
        display: inline-flex;
        align-items: center;
        border-radius: 7px;
        padding: 5px 9px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-warning {
        background: #fff4d6;
        color: #996c00;
    }

    .status-success {
        background: #e6f7ef;
        color: #137653;
    }

    .dashboard-section {
        margin-top: 32px;
    }

    .component-card {
        background: #ffffff;
        border: 1px solid #e9edf3;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(25, 42, 70, 0.045);
        overflow: hidden;
    }

    .maintenance-wrapper {
        width: 100%;
    }

    .cost-wrapper {
        margin-top: 25px;
    }

    .overview-label {
        color: #7b8495;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {

        .dashboard-header {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }

        .dashboard-title {
            font-size: 25px;
        }

        .header-badge {
            align-self: flex-start;
        }

        .kpi-card {
            padding: 20px;
        }
    }
</style>

<div class="dashboard-page">

    
    <div class="container">

        <!-- Dashboard Header -->
        <div class="dashboard-header">

            <div>
                <h1 class="dashboard-title">
                    Admin Dashboard
                </h1>

                <p class="dashboard-subtitle">
                    FleetCare Pro administration overview and fleet performance.
                </p>
            </div>

            <div class="header-badge">
                <span class="status-dot"></span>
                System Operational
            </div>

        </div>


        <!-- Fleet Overview -->
        <div class="overview-label">
            Fleet Overview
        </div>

        <div class="row g-4">

            <!-- Vehicles -->
            <div class="col-xl-4 col-md-6">

                <div class="kpi-card">

                    <div class="kpi-top">

                        <div>
                            <p class="kpi-label">
                                Vehicles
                            </p>
                        </div>

                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-truck"></i>
                        </div>

                    </div>

                    <div class="kpi-value">
                        @ViewBag.VehicleCount
                    </div>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="kpi-link">
                        Manage Vehicles
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>


            <!-- Service Centers -->
            <div class="col-xl-4 col-md-6">

                <div class="kpi-card">

                    <div class="kpi-top">

                        <div>
                            <p class="kpi-label">
                                Service Centers
                            </p>
                        </div>

                        <div class="kpi-icon icon-purple">
                            <i class="bi bi-building"></i>
                        </div>

                    </div>

                    <div class="kpi-value">
                        @ViewBag.ServiceCenterCount
                    </div>

                    <a asp-controller="ServiceCenter"
                       asp-action="Index"
                       class="kpi-link">
                        Manage Centers
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>


            <!-- Service Categories -->
            <div class="col-xl-4 col-md-6">

                <div class="kpi-card">

                    <div class="kpi-top">

                        <div>
                            <p class="kpi-label">
                                Service Categories
                            </p>
                        </div>

                        <div class="kpi-icon icon-orange">
                            <i class="bi bi-grid-3x3-gap"></i>
                        </div>

                    </div>

                    <div class="kpi-value">
                        @ViewBag.ServiceCategoryCount
                    </div>

                    <a asp-controller="ServiceCategory"
                       asp-action="Index"
                       class="kpi-link">
                        Manage Categories
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>


        <!-- Service Overview -->
        <div class="dashboard-section">

            <div class="overview-label">
                Service Overview
            </div>

            <div class="row g-4">

                <!-- Service Records -->
                <div class="col-xl-4 col-md-6">

                    <div class="kpi-card">

                        <div class="kpi-top">

                            <div>
                                <p class="kpi-label">
                                    Service Records
                                </p>
                            </div>

                            <div class="kpi-icon icon-green">
                                <i class="bi bi-clipboard2-check"></i>
                            </div>

                        </div>

                        <div class="kpi-value">
                            @ViewBag.ServiceRecordCount
                        </div>

                        <a asp-controller="ServiceRecord"
                           asp-action="Index"
                           class="kpi-link">
                            View Records
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </div>


                <!-- Pending Services -->
                <div class="col-xl-4 col-md-6">

                    <div class="kpi-card">

                        <div class="kpi-top">

                            <div>
                                <p class="kpi-label">
                                    Pending Services
                                </p>
                            </div>

                            <div class="kpi-icon icon-yellow">
                                <i class="bi bi-clock-history"></i>
                            </div>

                        </div>

                        <div class="kpi-value">
                            @ViewBag.PendingServiceRecords
                        </div>

                        <span class="kpi-status status-warning">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Awaiting Action
                        </span>

                    </div>

                </div>


                <!-- Completed Services -->
                <div class="col-xl-4 col-md-6">

                    <div class="kpi-card">

                        <div class="kpi-top">

                            <div>
                                <p class="kpi-label">
                                    Completed Services
                                </p>
                            </div>

                            <div class="kpi-icon icon-green">
                                <i class="bi bi-check-circle"></i>
                            </div>

                        </div>

                        <div class="kpi-value">
                            @ViewBag.CompletedServiceRecords
                        </div>

                        <span class="kpi-status status-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Completed
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Maintenance -->
        <div class="dashboard-section">

            <div class="overview-label">
                Maintenance Monitoring
            </div>

            <div class="maintenance-wrapper">

                @await Component.InvokeAsync("OverdueMaintenance")

            </div>

        </div>


        <!-- Fleet Costs -->
        <div class="dashboard-section cost-wrapper">

            <div class="overview-label">
                Fleet Cost Analysis
            </div>

            @await Component.InvokeAsync("FleetCostSummary")

        </div>

    </div>
    

</div>
